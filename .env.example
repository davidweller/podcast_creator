# Master secret for encrypting API keys stored in the local database (Settings UI).
# Min 16 characters. Required only if you use "Save keys" in Settings.
# COZYCRIME_SECRET=

# OpenRouter (optional — for OpenRouter-backed models in the model picker)
# OPENROUTER_API_KEY=
# Optional referer header for OpenRouter rankings
# OPENROUTER_HTTP_REFERER=http://localhost:3000

# OpenAI API Key (for ChatGPT Images 2.0 / gpt-image-2 on Images tab)
# Get your API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Anthropic Claude API Key
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Google Gemini API Key (for image generation and Gemini TTS on Speech tab)
# Get your API key from https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Service Account JSON (for Speech tab - Cloud TTS Chirp 3 HD voices)
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Enable the Cloud Text-to-Speech API for your project
# 3. Create a Service Account: IAM & Admin > Service Accounts > Create
# 4. Download the JSON key file
# 5. Paste the full JSON content into this variable
#    (matches the Settings provider entry for Google Cloud TTS)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id"}

# Europeana API Key (for Real Images tab - historical archive search)
# Register for free at https://pro.europeana.eu/page/get-api
# Note: Library of Congress and Wikimedia Commons APIs do not require keys
EUROPEANA_API_KEY=your_europeana_api_key_here
